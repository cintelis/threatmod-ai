# LLM Provider — anthropic | azure-openai
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=cintelis/threatmod-ai
GITHUB_FOLDER=architectures
GITHUB_OUTPUT_FOLDER=threat-models

# Power Automate
POWER_AUTOMATE_WEBHOOK_URL=
SECONDARY_APPROVER_EMAIL=

# AWS MCP Server
MCP_SERVER_ENDPOINT=
MCP_AUTH_METHOD=api-key
MCP_API_KEY=
TOOL_TIMEOUT_SECONDS=30
MAX_CONCURRENT_QUERIES=5
VERIFICATION_DEPTH=STANDARD
CACHE_TTL_HOURS=24

# Confluence
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_ID=
CONFLUENCE_PARENT_PAGE_ID=

# Pipeline
PORT=3000
PIPELINE_CONCURRENCY=3
APPROVAL_TIMEOUT_HOURS=72
